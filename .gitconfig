[user]
	name = organizedconfusion
	email = github@underclocked.com
[core]
    autocrlf = input
    editor = nvim
    excludesfile = ~/.gitignore_global
    pager = delta
[interactive]
    diffFilter = delta --color-only
[include]
    path = ~/deltathemes.gitconfig
[delta]
    features = everforest
    navigate = true
    line-numbers = true
    side-by-side = false
    pager = "less -FRSX"
[init]
    defaultBranch = main
[pull]
    rebase = false
    ff = true
[color]
    ui = auto
[alias]
    st = status
    tree = log --branches --remotes --tags --graph --decorate-refs-exclude=HEAD --pretty=format:'%C(yellow)%h%Creset %s%C(auto)%d%Creset%n%b'
    diffs = -c delta.side-by-side=true diff
    shows = -c delta.side-by-side=true show

    br = !git branch --format='%(refname:short)' \
        | fzf --preview 'git log --oneline --graph --decorate --color=always {} \
        | head -100' \
        | xargs git switch

    glog = !git log --oneline --color=always \
        | fzf -m --no-sort --layout=reverse --ansi --preview='git show --format="" {1} | delta' \
        | awk '{print $1}'
[rebase]
    autosquash = true
[commit]
    verbose = true
[help]
    autocorrect = prompt
[diff]
    algorithm = histogram
    ; colorMoved = default
    tool = nvimdiff
[difftool]
    prompt = true
[merge]
    conflictstyle = zdiff3
    tool = nvimdiff
[rerere]
    enabled = true
