[user]
	name = organizedconfusion
	email = github@underclocked.com
[core]
    autocrlf = input
    editor = nvim
    excludesfile = ~/.gitignore_global
    pager = delta
[interactive]
    diffFilter = delta --color-only
[include]
    path = ~/deltathemes.gitconfig
[delta]
    features = sean
    navigate = true
    line-numbers = true
    side-by-side = false
[init]
    defaultBranch = main
[pull]
    rebase = false
    ff = true
[color]
    ui = auto
[alias]
    st = status
    log-graph = log --oneline --graph --decorate
    tree = log --all --oneline --graph --decorate
    diffs = -c delta.side-by-side=true diff
[rebase]
    autosquash = true
[commit]
    verbose = true
[help]
    autocorrect = prompt
[diff]
    algorithm = histogram
    colorMoved = default
    tool = nvimdiff
[difftool]
    prompt = true
[merge]
    conflictstyle = zdiff3
    tool = nvimdiff
[rerere]
    enabled = true
