[user]
	name = organizedconfusion
	email = github@underclocked.com
[core]
    autocrlf = input
    editor = nvim
    excludesfile = ~/.gitignore_global
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    line-numbers = true
[init]
    defaultBranch = main
[pull]
    rebase = false
    ff = true
[color]
    ui = auto
[alias]
    st = status
    lg = log --oneline --graph --decorate
    lga = log --all --oneline --graph --decorate
[rebase]
    autosquash = true
[commit]
    verbose = true
[help]
    autocorrect = immediate
[diff]
    algorithm = histogram
[merge]
    conflictstyle = zdiff3
    tool = nvimdiff
[rerere]
    enabled = true
