[delta "gruvbox-material-soft-dark"]
	dark = true
	syntax-theme = gruvbox-material-soft-dark

	# File
	file-style = bold "#d4be98"
	file-added-label = [+]
	file-copied-label = [==]
	file-modified-label = [*]
	file-removed-label = [-]
	file-renamed-label = [->]
	file-decoration-style = "#928374" ul ol bold

	# Hunk headers
	hunk-header-style = italic dim
	hunk-header-file-style = dim
	hunk-header-line-number-style = dim
	hunk-header-decoration-style = box dim

	# Line numbers
	line-numbers = true
	line-numbers-left-style = "#7daea3"
	line-numbers-right-style = "#7daea3"
	line-numbers-minus-style = "#ea6962"
	line-numbers-plus-style = "#a9b665"
	line-numbers-zero-style = "#928374"

	line-numbers-left-format = " {nm:>3} │"
	line-numbers-right-format = " {np:>3} │"

	# Diff contents
	inline-hint-style = syntax

	# gruvbox-material bg_diff_red
	minus-style = syntax "#472322"
	# 35% red 65% bg0
	minus-emph-style = syntax "#724441"
	minus-non-emph-style = minus-style

	# gruvbox-material bg_diff_green
	plus-style = syntax "#3d4220"
	# 35% green 65% bg0
	plus-emph-style = syntax "#5c5f42"
	plus-non-emph-style = plus-style

	map-styles = \
		bold purple => syntax "#4b3e45", \
		bold blue => syntax "#404946", \
		bold cyan => syntax "#424a3e", \
		bold yellow => syntax "#574833"

	whitespace-error-style = "#ea6962" reverse

	# Blame
	blame-code-style = syntax
	blame-format = "{author:>18} ({commit:>8}) {timestamp:<13} "
	blame-palette = "#32302f" "#252423" "#3c3836" "#504945"

	# Merge conflicts
	merge-conflict-begin-symbol = ⌃
	merge-conflict-end-symbol = ⌄
	merge-conflict-ours-diff-header-style = "#d8a657" bold
	merge-conflict-theirs-diff-header-style = "#d8a657" bold overline
	merge-conflict-ours-diff-header-decoration-style = ''
