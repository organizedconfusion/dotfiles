        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>#89b482</string>
        </dict>
      </dict>

      <!-- Language constructs -->
      <dict>
        <key>name</key>
        <string>Keywords</string>
        <key>scope</key>
        <string>keyword, storage, storage.type.function, storage.modifier</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>#ea6962</string>
